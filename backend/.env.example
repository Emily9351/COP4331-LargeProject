# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/your-database-name

# Server Configuration
PORT=80

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# ============================================
# EMAIL CONFIGURATION - SENDGRID (Recommended)
# ============================================
# SendGrid is recommended because it works on all hosting providers
# and bypasses SMTP port blocking issues

# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here

# From email (must be verified in SendGrid)
# Go to: https://app.sendgrid.com/settings/sender_auth
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# ALTERNATIVE: SMTP EMAIL (Gmail, etc.)
# ============================================
# Note: SMTP may not work on servers that block ports 587/465
# Only use this if SendGrid doesn't work for you

# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password

# Notes for Gmail:
# - You need to use an "App Password" not your regular password
# - To generate: https://myaccount.google.com/apppasswords
# - Enable 2-Step Verification first
